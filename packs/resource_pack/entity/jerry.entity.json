{
  "format_version": "1.10.0",
  "minecraft:client_entity": {
    "description": {
      "identifier": "jf:jerry",
      "materials": {
        "default": "wolf",
        "extras": "entity_alphatest",
        "face": "entity_alphatest"
      },
      "textures": {
        "default": "textures/entity/wolf/wolf_tame",
        "coat_ashen": "textures/entity/wolf/wolf_ashen_tame",
        "coat_black": "textures/entity/wolf/wolf_black_tame",
        "coat_chestnut": "textures/entity/wolf/wolf_chestnut_tame",
        "coat_rusty": "textures/entity/wolf/wolf_rusty_tame",
        "coat_snowy": "textures/entity/wolf/wolf_snowy_tame",
        "coat_spotted": "textures/entity/wolf/wolf_spotted_tame",
        "coat_striped": "textures/entity/wolf/wolf_striped_tame",
        "coat_woods": "textures/entity/wolf/wolf_woods_tame",
        "extras": "textures/entity/jf_jerry_extras",
        "face_happy": "textures/entity/jf_jerry_face_happy",
        "face_puppy": "textures/entity/jf_jerry_face_puppy",
        "face_shocked": "textures/entity/jf_jerry_face_shocked",
        "face_love": "textures/entity/jf_jerry_face_love",
        "face_sleepy": "textures/entity/jf_jerry_face_sleepy"
      },
      "geometry": {
        "default": "geometry.jf_jerry",
        "extras": "geometry.jf_jerry_extras",
        "face": "geometry.jf_jerry_face"
      },
      "animations": {
        "look_at_target": "animation.common.look_at_target",
        "walk": "animation.jf_jerry.walk",
        "tail_wag": "animation.jf_jerry.tail_wag",
        "sit": "animation.jf_jerry.sit",
        "roll_over": "animation.jf_jerry.roll_over",
        "head_tilt": "animation.jf_jerry.head_tilt",
        "speaker_pop": "animation.jf_jerry.speaker_pop",
        "pose": "controller.animation.jf_jerry.pose",
        "speaker": "controller.animation.jf_jerry.speaker",
        "paw": "animation.jf_jerry.paw",
        "wave": "animation.jf_jerry.wave",
        "beg": "animation.jf_jerry.beg",
        "dance": "animation.jf_jerry.dance",
        "play_dead": "animation.jf_jerry.play_dead",
        "lie": "animation.jf_jerry.lie",
        "bow": "animation.jf_jerry.bow",
        "backflip": "animation.jf_jerry.backflip",
        "howl": "animation.jf_jerry.howl",
        "sniff": "animation.jf_jerry.sniff",
        "shy": "animation.jf_jerry.shy",
        "stretch": "animation.jf_jerry.stretch",
        "baby": "animation.jf_jerry.baby"
      },
      "scripts": {
        "animate": [
          "look_at_target",
          {
            "walk": "query.modified_move_speed"
          },
          "tail_wag",
          "pose",
          "speaker",
          {
            "baby": "query.is_baby"
          }
        ]
      },
      "render_controllers": [
        "controller.render.jf_jerry",
        "controller.render.jf_jerry_extras",
        {
          "controller.render.jf_jerry_face": "query.property('jf:face') > 0"
        }
      ]
    }
  }
}
