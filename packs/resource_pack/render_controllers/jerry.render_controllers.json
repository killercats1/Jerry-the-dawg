{
  "format_version": "1.8.0",
  "render_controllers": {
    "controller.render.jf_jerry": {
      "arrays": {
        "textures": {
          "Array.coats": [
            "Texture.default",
            "Texture.coat_ashen",
            "Texture.coat_black",
            "Texture.coat_chestnut",
            "Texture.coat_rusty",
            "Texture.coat_snowy",
            "Texture.coat_spotted",
            "Texture.coat_striped",
            "Texture.coat_woods"
          ]
        }
      },
      "geometry": "Geometry.default",
      "materials": [
        {
          "*": "Material.default"
        }
      ],
      "textures": [
        "Array.coats[query.property('jf:coat')]"
      ]
    },
    "controller.render.jf_jerry_extras": {
      "geometry": "Geometry.extras",
      "materials": [
        {
          "*": "Material.extras"
        }
      ],
      "textures": [
        "Texture.extras"
      ],
      "part_visibility": [
        {
          "speaker": "query.property('jf:speaking')"
        },
        {
          "mouth_bone": "query.property('jf:bone')"
        },
        {
          "mouth_ball": "query.property('jf:ball')"
        },
        {
          "bandana": "query.property('jf:neck') == 1"
        },
        {
          "bow_tie": "query.property('jf:neck') == 2"
        },
        {
          "party_hat": "query.property('jf:hat') == 1"
        },
        {
          "flower_crown": "query.property('jf:hat') == 2"
        },
        {
          "shades": "query.property('jf:hat') == 3"
        }
      ]
    },
    "controller.render.jf_jerry_face": {
      "arrays": {
        "textures": {
          "Array.faces": [
            "Texture.face_happy",
            "Texture.face_happy",
            "Texture.face_puppy",
            "Texture.face_shocked",
            "Texture.face_love",
            "Texture.face_sleepy"
          ]
        }
      },
      "geometry": "Geometry.face",
      "materials": [
        {
          "*": "Material.face"
        }
      ],
      "textures": [
        "Array.faces[query.property('jf:face')]"
      ],
      "part_visibility": [
        {
          "face": "query.property('jf:face') > 0"
        }
      ]
    }
  }
}
