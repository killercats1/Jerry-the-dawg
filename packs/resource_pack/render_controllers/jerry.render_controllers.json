{
  "format_version": "1.8.0",
  "render_controllers": {
    "controller.render.jf_jerry": {
      "geometry": "Geometry.default",
      "materials": [
        {
          "*": "Material.default"
        }
      ],
      "textures": [
        "Texture.default"
      ]
    },
    "controller.render.jf_jerry_extras": {
      "geometry": "Geometry.extras",
      "materials": [
        {
          "*": "Material.extras"
        }
      ],
      "textures": [
        "Texture.extras"
      ],
      "part_visibility": [
        {
          "speaker": "query.property('jf:speaking')"
        },
        {
          "mouth_bone": "query.property('jf:bone')"
        },
        {
          "mouth_ball": "query.property('jf:ball')"
        }
      ]
    },
    "controller.render.jf_jerry_face": {
      "arrays": {
        "textures": {
          "Array.faces": [
            "Texture.face_happy",
            "Texture.face_happy",
            "Texture.face_puppy",
            "Texture.face_shocked",
            "Texture.face_love",
            "Texture.face_sleepy"
          ]
        }
      },
      "geometry": "Geometry.face",
      "materials": [
        {
          "*": "Material.face"
        }
      ],
      "textures": [
        "Array.faces[query.property('jf:face')]"
      ],
      "part_visibility": [
        {
          "face": "query.property('jf:face') > 0"
        }
      ]
    }
  }
}
