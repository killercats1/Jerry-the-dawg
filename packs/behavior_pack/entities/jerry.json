{
  "format_version": "1.20.80",
  "minecraft:entity": {
    "description": {
      "identifier": "jf:jerry",
      "is_spawnable": false,
      "is_summonable": true,
      "is_experimental": false,
      "properties": {
        "jf:pose": { "type": "int", "range": [0, 3], "default": 0, "client_sync": true },
        "jf:speaking": { "type": "bool", "default": false, "client_sync": true }
      }
    },
    "component_groups": {
      "jf:wild": {
        "minecraft:tameable": {
          "probability": 1.0,
          "tame_items": "bone",
          "tame_event": { "event": "jf:on_tame", "target": "self" }
        }
      },
      "jf:tame": {
        "minecraft:is_tamed": {}
      },
      "jf:moving": {
        "minecraft:behavior.follow_owner": { "priority": 4, "speed_multiplier": 1.0, "start_distance": 8, "stop_distance": 2 },
        "minecraft:behavior.random_stroll": { "priority": 7, "speed_multiplier": 0.8 }
      },
      "jf:sitting": {
        "minecraft:mark_variant": { "value": 1 }
      }
    },
    "components": {
      "minecraft:type_family": { "family": ["jerry", "dog", "mob"] },
      "minecraft:collision_box": { "width": 0.6, "height": 0.85 },
      "minecraft:health": { "value": 40, "max": 40 },
      "minecraft:damage_sensor": { "triggers": { "cause": "all", "deals_damage": false } },
      "minecraft:fire_immune": {},
      "minecraft:persistent": {},
      "minecraft:nameable": {},
      "minecraft:breathable": { "total_supply": 15, "suffocate_time": 0 },
      "minecraft:physics": {},
      "minecraft:pushable": { "is_pushable": true, "is_pushable_by_piston": true },
      "minecraft:movement": { "value": 0.3 },
      "minecraft:movement.basic": {},
      "minecraft:jump.static": {},
      "minecraft:navigation.walk": { "can_path_over_water": true, "avoid_water": true, "avoid_damage_blocks": true },
      "minecraft:leashable": { "soft_distance": 4, "hard_distance": 6, "max_distance": 10 },
      "minecraft:ambient_sound_interval": { "value": 10, "range": 20, "event_name": "ambient" },
      "minecraft:behavior.float": { "priority": 0 },
      "minecraft:behavior.look_at_player": { "priority": 8, "look_distance": 6, "probability": 0.04 },
      "minecraft:behavior.random_look_around": { "priority": 9 },
      "minecraft:interact": {
        "interactions": [
          {
            "on_interact": {
              "filters": { "test": "is_family", "subject": "other", "value": "player" },
              "event": "jf:petted",
              "target": "self"
            },
            "interact_text": "action.interact.jf_pet",
            "swing": true
          }
        ]
      }
    },
    "events": {
      "minecraft:entity_spawned": { "add": { "component_groups": ["jf:wild", "jf:moving"] } },
      "jf:on_tame": { "remove": { "component_groups": ["jf:wild"] }, "add": { "component_groups": ["jf:tame"] } },
      "jf:sit": { "remove": { "component_groups": ["jf:moving"] }, "add": { "component_groups": ["jf:sitting"] } },
      "jf:stand": { "remove": { "component_groups": ["jf:sitting"] }, "add": { "component_groups": ["jf:moving"] } },
      "jf:petted": {}
    }
  }
}
